# Copy this file to `.env.local` and fill in real values:
#   cp .env.example .env.local
#
# `.env.local` is git-ignored. Anything prefixed NEXT_PUBLIC_ is embedded into the
# JavaScript bundle and is therefore readable by anyone using the site — never put a
# secret behind that prefix.

# Base URL of the Spring Boot backend, including the /api path.
NEXT_PUBLIC_API_URL=http://localhost:8081/api

# Stripe PUBLISHABLE key (pk_test_...), not the secret key.
# Safe in the browser by design; the secret key stays on the server.
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=
