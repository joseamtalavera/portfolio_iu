# Copy this file to `.env` in the same directory and fill in real values.
#   cp .env.example .env
#
# `.env` is git-ignored and must never be committed. This template is committed so that
# anyone cloning the repository knows exactly which values the application needs.
# In a real deployment these would be supplied as genuine environment variables
# (or from a secret manager) rather than from a file.

# --- Database ---------------------------------------------------------------
# Credentials of the local PostgreSQL user that owns `database_iu`.
DB_USERNAME=bework_user
DB_PASSWORD=change_me

# --- JWT --------------------------------------------------------------------
# Signing key for authentication tokens. The server signs every token with this key
# and verifies it on every request, so anyone holding it can forge a token for any
# user. Generate your own, never reuse someone else's:
#
#   openssl rand -base64 64 | tr -d '\n'
#
JWT_SECRET=

# --- Stripe -----------------------------------------------------------------
# From the Stripe dashboard (test mode is fine). The secret key stays on the server
# and is never exposed to the browser.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
